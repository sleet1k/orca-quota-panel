{
  "manifestVersion": 2,
  "id": "quota-panel",
  "name": "Quota Panel",
  "version": "0.4.0",
  "description": "Панель остатка бесплатного лимита OpenRouter (rpd, сброс 05:00 Астана) с режимами ТУРБО/БАЛАНС/ЭКО.",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "quota-panel",
        "title": "Quota Panel",
        "icon": "blocks",
        "entry": "src/panel.html",
        "ui": "html"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    }
  ]
}
